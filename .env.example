# Home Kumon configuration (all optional — sensible defaults are auto-detected)

# Where the SQLite database + generated content live.
# --- Data directory ---
# Default: ./data next to the app (same folder as run.sh).
# Optional: point elsewhere (e.g. OneDrive) for cloud backup:
# HOMEKUMON_DATA_DIR=/path/to/your/HomeKumon/data

# LM Studio local server (OpenAI-compatible). Defaults below match LM Studio's defaults.
# These can also be changed live in the Parent dashboard.
# HOMEKUMON_LMSTUDIO_URL=http://localhost:1234/v1
# HOMEKUMON_LMSTUDIO_MODEL=        # blank = auto-detect the loaded model

# Web server
# HOMEKUMON_HOST=127.0.0.1
# HOMEKUMON_PORT=8700
