# .gitignore

# Byte-compiled / optimized / untracked files
__pycache__/
*.py[cod]
*$py.class
.cursor/
.pytest_cache/

# Environments
.venv/
venv/
ENV/
env/
.env
.env.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build and distribution
dist/
build/
*.egg-info/
*.egg

# Database (Local only)
*.db
*.sqlite3

# Logs
*.log
logs/
